# Rust
/target/
**/target/
Cargo.lock.bak
*.pdb

# fdev build output (compiled WASM contract packages - rebuild with
# `fdev build`, see CLAUDE.md for the CARGO_TARGET_DIR workaround needed)
contracts/*/build/

# Node / Frontend
node_modules/
dist/
dist-ssr/
*.local
app/src-tauri/target/

# Tauri build outputs
app/src-tauri/gen/

# Local SQLite / Delegate runtime data (real location is the OS app-data
# dir via `directories::ProjectDirs`, not this repo - these patterns are
# just a safety net in case a build ever writes locally).
*.sqlite
*.sqlite3
*.db
delegate/data/
delegate/delegate/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
