# Rust
/target/
**/target/
Cargo.lock.bak
*.pdb

# fdev build output (compiled WASM contract packages - rebuild with
# `fdev build`, see CLAUDE.md for the CARGO_TARGET_DIR workaround needed)
contracts/*/build/

# Node / Frontend
node_modules/
dist/
dist-ssr/
*.local
*.tsbuildinfo
app/src-tauri/target/

# Tauri build outputs
app/src-tauri/gen/

# Sidecar binary copied from delegate/target/{debug,release}/ at build/dev
# time (see CLAUDE.md's "Desktop shell (Tauri)" section) - not source, must
# be regenerated locally before `npm run tauri dev`/`build`.
app/src-tauri/binaries/

# `npm run build:desktop`'s copy of the latest installer/exe - see
# app/scripts/copy-build-artifacts.mjs. Not source, regenerated per build.
/builds/

# Locally-installed agent skills (e.g. `npx skills add ...`) - machine-local
# tooling, not project source.
/.agents/
/.claude/skills/
skills-lock.json

# Machine-local Claude Code permission state, not project config.
/.claude/settings.local.json

# Local SQLite / Delegate runtime data (real location is the OS app-data
# dir via `directories::ProjectDirs`, not this repo - these patterns are
# just a safety net in case a build ever writes locally).
*.sqlite
*.sqlite3
*.db
delegate/data/
delegate/delegate/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# scripts/dev-up.sh's pidfile for the delegate it starts (see scripts/).
.dev-delegate.pid
