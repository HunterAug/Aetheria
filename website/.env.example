# Set to "true" once the app is actually ready to be downloaded - until
# then the download buttons show "Coming soon!" instead. See lib/config.ts.
# Copy to .env.local for local testing, or set in Vercel's project settings
# (Environment Variables) for production.
IsReleased=false

# Secret key for the private preview link (https://yourdomain/<this-value>).
# Visiting that URL sets a cookie that bypasses the IsReleased gate above,
# for sharing real download links before flipping IsReleased for everyone.
# Generate your own random value, never reuse this placeholder - see
# app/[key]/route.ts and CLAUDE.md's "Private preview bypass" section.
PREVIEW_ACCESS_KEY=replace-with-a-long-random-value
